# Optional dedicated Solana RPC endpoints (recommended for mainnet).
# Never put private keys or secret API tokens in VITE_* vars — they are public in the browser.
# If your RPC provider uses a secret path, prefer a reverse proxy; do not embed secrets here.

VITE_SOLANA_MAINNET_RPC=https://your-solana-mainnet-rpc.example
VITE_SOLANA_DEVNET_RPC=https://your-solana-devnet-rpc.example
